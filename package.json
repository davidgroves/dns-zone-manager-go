{
  "name": "dns-gui-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:check && playwright test",
    "test:e2e:ui": "playwright test --ui-port=9323 --ui-host=0.0.0.0",
    "test:e2e:headed": "npm run test:e2e:check && playwright test --headed",
    "test:e2e:report": "playwright show-report --host 0.0.0.0 --port 9324",
    "test:e2e:check": "curl -sf http://localhost:8000/health > /dev/null || (echo 'ERROR: Go backend not running. Start servers with VS Code task: Run All' && exit 1); test $(curl -sf -H 'X-API-Key: demo-api-key-12345' 'http://localhost:8000/v1/zones' | grep -c '\"zone\":') -gt 0 || (echo 'ERROR: No zones loaded. Is BIND running?' && exit 1)",
    "types:generate": "openapi-typescript http://localhost:8000/openapi.json -o frontend/types/api.d.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.58.0",
    "@types/alpinejs": "^3.13.10",
    "@vitest/coverage-v8": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "alpinejs": "^3.14.0"
  }
}
