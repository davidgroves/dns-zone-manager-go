{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SPA",
      "type": "shell",
      "command": "npx tsc && npx vite build",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "BACKEND",
      "type": "shell",
      "command": "go run ./cmd/dns-zone-manager serve --config .devcontainer/config.devcontainer.yaml --ui-dir dist",
      "dependsOn": ["Build SPA"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "BACKEND (Local)",
      "type": "shell",
      "command": "go run ./cmd/dns-zone-manager serve --config examples/config.yaml --ui-dir dist",
      "dependsOn": ["Build SPA"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Vite (optional)",
      "type": "shell",
      "command": "npm run dev",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "BIND",
      "type": "shell",
      "command": "sudo docker logs -f dns-zone-manager-go_devcontainer-bind-1",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "POSTGRES",
      "type": "shell",
      "command": "sudo docker logs -f dns-zone-manager-go_devcontainer-postgres-1",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ZONE CHURN",
      "type": "shell",
      "command": "BIND_HOST=bind BIND_PORT=15353 API_BASE=http://127.0.0.1:8000 API_KEY= INTERVAL_SEC=5 /workspace/examples/always-changing/churn.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "PERF: Create 5M zone",
      "type": "shell",
      "command": "API_BASE=http://127.0.0.1:8000 BIND_HOST=bind BIND_PORT=15353 ./perf.sh zone create --preset 5m",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "PERF: Run all",
      "type": "shell",
      "command": "API_BASE=http://127.0.0.1:8000 BIND_HOST=bind BIND_PORT=15353 ./perf.sh run all",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "PERF: Destroy zone",
      "type": "shell",
      "command": "API_BASE=http://127.0.0.1:8000 BIND_HOST=bind BIND_PORT=15353 ./perf.sh zone destroy --delete-file",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run All",
      "dependsOn": ["BACKEND", "BIND", "POSTGRES"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run All (Local)",
      "dependsOn": ["BACKEND (Local)"],
      "dependsOrder": "parallel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Shutdown All",
      "type": "shell",
      "command": "echo '\\n📋 To stop all running services:\\n\\n   Press Ctrl+Shift+P → \"Terminal: Kill All Terminals\"\\n\\n   Or click the trash icon in each terminal panel.\\n'",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Rebuild Dev Container",
      "type": "shell",
      "command": "echo '\\n📋 To rebuild the dev container:\\n\\n   1. Stop services: Ctrl+Shift+P → \"Terminal: Kill All Terminals\"\\n   2. Rebuild: Ctrl+Shift+P → \"Dev Containers: Rebuild Container\"\\n\\nThis will rebuild the container image and restart all services.\\n'",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "./tests.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Backend Tests",
      "type": "shell",
      "command": "go test ./...",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Backend Unit Tests",
      "type": "shell",
      "command": "go test ./internal/... ./cmd/...",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Frontend Tests",
      "type": "shell",
      "command": "npm run test",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run E2E Tests",
      "type": "shell",
      "command": "npm run test:e2e",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint All",
      "type": "shell",
      "command": "golangci-lint run ./... && npm run lint",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Format All",
      "type": "shell",
      "command": "gofmt -w $(find . -name '*.go' -not -path './.git/*') && npm run format",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "go vet ./... && npm run typecheck",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
